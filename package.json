{
  "name": "warehouse-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx node_modules/sequelize-cli/lib/sequelize db:migrate",
    "migrate:undo": "tsx node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "seed": "tsx node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "seed:undo": "tsx node_modules/sequelize-cli/lib/sequelize db:seed:undo:all",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:report": "jest --runInBand && node tests/scripts/generate_excel.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duancoders03/warehouse_test.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Duancoders03/warehouse_test/issues"
  },
  "homepage": "https://github.com/Duancoders03/warehouse_test#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
