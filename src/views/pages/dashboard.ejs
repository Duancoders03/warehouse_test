<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tổng Quan Kho Hàng & Nhập Kho</h1>
      <p class="text-sm text-slate-500 mt-1">Chào mừng bạn trở lại! Báo cáo hoạt động nhập kho và chứng từ Mẫu 01-VT.</p>
    </div>
    <div class="flex items-center space-x-3">
      <a href="/receipts/create" class="inline-flex items-center justify-center px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium text-sm rounded-xl shadow-sm transition-all hover:shadow-lg hover:shadow-sky-500/20">
        <i class="fa-solid fa-plus mr-2"></i> Lập Phiếu Nhập Mới
      </a>
    </div>
  </div>

  <!-- Key Metrics / Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- Total Receipts Card -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Số Phiếu Nhập</span>
        <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
      </div>
      <div class="mt-4">
        <span class="text-3xl font-extrabold text-slate-900"><%= stats.totalReceipts %></span>
        <span class="text-xs text-emerald-600 font-medium ml-2"><i class="fa-solid fa-arrow-up"></i> Đã hoàn thành</span>
      </div>
    </div>

    <!-- Total Value Card -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Tổng Giá Trị Nhập Kho</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-sack-dollar"></i>
        </div>
      </div>
      <div class="mt-4">
        <span class="text-2xl font-extrabold text-slate-900"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(stats.totalAmount) %></span>
      </div>
    </div>

    <!-- Items Count Card -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Vật Tư Danh Mục</span>
        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-boxes-packing"></i>
        </div>
      </div>
      <div class="mt-4">
        <span class="text-3xl font-extrabold text-slate-900"><%= stats.itemsCount %></span>
        <span class="text-xs text-slate-500 ml-2">mã vật tư active</span>
      </div>
    </div>

    <!-- Warehouses Count Card -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Kho Hàng Hoạt Động</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg">
          <i class="fa-solid fa-warehouse"></i>
        </div>
      </div>
      <div class="mt-4">
        <span class="text-3xl font-extrabold text-slate-900"><%= stats.warehousesCount %></span>
        <span class="text-xs text-slate-500 ml-2">kho trực thuộc</span>
      </div>
    </div>

  </div>

  <!-- Recent Receipts Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900">Phiếu Nhập Kho Mới Nhất</h2>
        <p class="text-xs text-slate-500">Các chứng từ phiếu nhập mới tạo trong hệ thống</p>
      </div>
      <a href="/receipts" class="text-sm font-medium text-sky-600 hover:text-sky-700 flex items-center">
        Xem tất cả <i class="fa-solid fa-chevron-right text-xs ml-1.5"></i>
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
            <th class="py-3.5 px-6">Số Phiếu</th>
            <th class="py-3.5 px-4">Ngày Nhập</th>
            <th class="py-3.5 px-4">Nhà Cung Cấp</th>
            <th class="py-3.5 px-4">Kho Nhận</th>
            <th class="py-3.5 px-4 text-right">Tổng Tiền (VNĐ)</th>
            <th class="py-3.5 px-6 text-center">Thao Tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if (recentReceipts && recentReceipts.length > 0) { %>
            <% recentReceipts.forEach(receipt => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6 font-semibold text-sky-700">
                  <a href="/receipts/<%= receipt.id %>" class="hover:underline">
                    <%= receipt.receipt_no %>
                  </a>
                </td>
                <td class="py-4 px-4 text-slate-600"><%= receipt.receipt_date %></td>
                <td class="py-4 px-4 text-slate-800 font-medium"><%= receipt.supplier ? receipt.supplier.name : 'N/A' %></td>
                <td class="py-4 px-4 text-slate-600"><%= receipt.warehouse ? receipt.warehouse.name : 'N/A' %></td>
                <td class="py-4 px-4 text-right font-bold text-slate-900">
                  <%= new Intl.NumberFormat('vi-VN').format(receipt.total_amount) %> đ
                </td>
                <td class="py-4 px-6 text-center">
                  <a href="/receipts/<%= receipt.id %>" class="inline-flex items-center px-3 py-1.5 bg-slate-100 hover:bg-sky-50 text-sky-700 hover:text-sky-800 font-medium text-xs rounded-lg transition-colors">
                    <i class="fa-solid fa-print mr-1"></i> Xem Mẫu 01-VT
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-8 text-center text-slate-400 text-sm">Chưa có phiếu nhập kho nào.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>
