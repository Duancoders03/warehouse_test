<div class="min-h-[60vh] flex items-center justify-center py-12">
  <div class="text-center space-y-4 max-w-md">
    <div class="w-20 h-20 bg-sky-100 text-sky-600 rounded-3xl flex items-center justify-center mx-auto text-4xl shadow-inner">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">404 - Không Tìm Thấy Trang</h1>
    <p class="text-slate-500 text-sm">
      <%= typeof message !== 'undefined' ? message : 'Trang bạn đang truy cập không tồn tại hoặc đã bị di chuyển.' %>
    </p>
    <div class="pt-4">
      <a href="/" class="inline-flex items-center px-5 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium text-sm rounded-xl shadow-md transition-colors">
        <i class="fa-solid fa-house mr-2"></i> Quay Về Trang Chủ
      </a>
    </div>
  </div>
</div>
