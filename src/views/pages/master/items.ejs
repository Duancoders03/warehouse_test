<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Danh Mục Vật Tư / Hàng Hóa</h1>
      <p class="text-sm text-slate-500 mt-1">Quản lý danh sách vật tư, quy cách và đơn vị tính (Cột B & C Mẫu 01-VT)</p>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Search Keyword -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Tìm Kiếm Vật Tư</label>
        <div class="relative">
          <input type="text" id="itemSearchKeyword" placeholder="Mã vật tư, tên hàng hóa, quy cách..." class="w-full text-sm pl-9 pr-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
        </div>
      </div>

      <!-- Filter by Unit -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Lọc Theo Đơn Vị Tính</label>
        <select id="itemUnitFilter" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả đơn vị tính --</option>
          <% if (typeof units !== 'undefined') { %>
            <% units.forEach(u => { %>
              <option value="<%= u.id %>"><%= u.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

    </div>
  </div>

  <!-- Items Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm" id="itemsTable">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
            <th class="py-3.5 px-6">Mã Vật Tư (Cột C)</th>
            <th class="py-3.5 px-6">Tên Vật Tư (Cột B)</th>
            <th class="py-3.5 px-6">Quy Cách Phẩm Chất</th>
            <th class="py-3.5 px-6">Đơn Vị Tính (Cột D)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% items.forEach(item => { %>
            <tr class="item-row hover:bg-slate-50/80 transition-colors"
                data-unit-id="<%= item.unit_id || '' %>"
                data-search="<%= (item.code + ' ' + item.name + ' ' + (item.specifications || '')).toLowerCase() %>">
              <td class="py-4 px-6 font-mono font-bold text-sky-700"><%= item.code %></td>
              <td class="py-4 px-6 font-bold text-slate-900"><%= item.name %></td>
              <td class="py-4 px-6 text-slate-600 text-xs"><%= item.specifications || 'Chưa cập nhật' %></td>
              <td class="py-4 px-6">
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-700 border border-sky-200">
                  <%= item.unit ? item.unit.name : 'N/A' %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const keywordInput = document.getElementById('itemSearchKeyword');
    const unitFilter = document.getElementById('itemUnitFilter');
    const rows = document.querySelectorAll('.item-row');

    function applyFilters() {
      const keyword = (keywordInput?.value || '').toLowerCase().trim();
      const unitId = unitFilter?.value || '';

      rows.forEach(row => {
        const rowSearch = row.dataset.search || '';
        const rowUnit = row.dataset.unitId || '';

        const matchKeyword = !keyword || rowSearch.includes(keyword);
        const matchUnit = !unitId || rowUnit === unitId;

        if (matchKeyword && matchUnit) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    keywordInput?.addEventListener('input', applyFilters);
    unitFilter?.addEventListener('change', applyFilters);
  });
</script>
