<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Danh Mục Nhà Cung Cấp</h1>
      <p class="text-sm text-slate-500 mt-1">Danh sách đối tác giao hàng và mã số thuế</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
            <th class="py-3.5 px-6">Mã NCC</th>
            <th class="py-3.5 px-6">Tên Nhà Cung Cấp</th>
            <th class="py-3.5 px-6">Mã Số Thuế</th>
            <th class="py-3.5 px-6">Địa Chỉ trụ sở</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% suppliers.forEach(s => { %>
            <tr class="hover:bg-slate-50">
              <td class="py-4 px-6 font-mono font-bold text-sky-700"><%= s.code %></td>
              <td class="py-4 px-6 font-semibold text-slate-900"><%= s.name %></td>
              <td class="py-4 px-6 text-slate-600 font-mono"><%= s.tax_code || 'N/A' %></td>
              <td class="py-4 px-6 text-slate-600 text-xs"><%= s.address || 'Chưa cập nhật' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
