<div class="space-y-6">
  
  <!-- Header & Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Danh Sách Phiếu Nhập Kho</h1>
      <p class="text-sm text-slate-500 mt-1">Quản lý và tra cứu các chứng từ phiếu nhập kho Mẫu 01-VT</p>
    </div>
    <div>
      <a href="/receipts/create" class="inline-flex items-center justify-center px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-medium text-sm rounded-xl shadow-sm transition-all hover:shadow-lg hover:shadow-sky-500/20">
        <i class="fa-solid fa-plus mr-2"></i> Lập Phiếu Nhập Kho
      </a>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
    <form method="GET" action="/receipts" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Từ Khóa Search</label>
        <input type="text" name="keyword" value="<%= query.keyword || '' %>" placeholder="Mã phiếu, HĐ, người giao..." class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Lọc Theo Kho</label>
        <select name="warehouse_id" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả kho --</option>
          <% warehouses.forEach(w => { %>
            <option value="<%= w.id %>" <%= query.warehouse_id === w.id ? 'selected' : '' %>><%= w.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Lọc Theo Nhà Cung Cấp</label>
        <select name="supplier_id" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả nhà cung cấp --</option>
          <% suppliers.forEach(s => { %>
            <option value="<%= s.id %>" <%= query.supplier_id === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Trạng Thái Phiếu</label>
        <select name="status" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả trạng thái --</option>
          <option value="DRAFT" <%= query.status === 'DRAFT' ? 'selected' : '' %>>Draft (Nháp)</option>
          <option value="PUBLIC" <%= query.status === 'PUBLIC' ? 'selected' : '' %>>Public (Đã Phát Hành)</option>
          <option value="CANCEL" <%= query.status === 'CANCEL' ? 'selected' : '' %>>Cancel (Đã Hủy)</option>
        </select>
      </div>

      <div class="flex items-end space-x-2">
        <button type="submit" class="w-full py-2 bg-slate-900 hover:bg-slate-800 text-white font-medium text-sm rounded-xl transition-colors cursor-pointer">
          <i class="fa-solid fa-filter mr-1.5"></i> Lọc Dữ Liệu
        </button>
        <a href="/receipts" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium text-sm rounded-xl transition-colors">
          <i class="fa-solid fa-rotate-left"></i>
        </a>
      </div>
    </form>
  </div>

  <!-- Receipts List Table Card -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col justify-between">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
            <th class="py-3.5 px-6 whitespace-nowrap">Mã / Số Phiếu</th>
            <th class="py-3.5 px-4 whitespace-nowrap">Ngày Nhập</th>
            <th class="py-3.5 px-4 whitespace-nowrap">Chứng Từ Gốc</th>
            <th class="py-3.5 px-4 whitespace-nowrap">Nhà Cung Cấp</th>
            <th class="py-3.5 px-4 whitespace-nowrap">Kho Thực Nhập</th>
            <th class="py-3.5 px-4 text-right whitespace-nowrap">Tổng Tiền (VNĐ)</th>
            <th class="py-3.5 px-4 text-center whitespace-nowrap">Trạng Thái</th>
            <th class="py-3.5 px-6 text-center whitespace-nowrap min-w-[200px]">Hành Động</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if (receipts && receipts.length > 0) { %>
            <% receipts.forEach(receipt => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-4 px-6 font-bold text-sky-700 whitespace-nowrap">
                  <a href="/receipts/<%= receipt.id %>" class="hover:underline flex items-center">
                    <i class="fa-solid fa-file-lines text-sky-500 mr-2"></i> <%= receipt.receipt_no %>
                  </a>
                </td>
                <td class="py-4 px-4 text-slate-600 whitespace-nowrap"><%= receipt.receipt_date %></td>
                <td class="py-4 px-4 text-slate-600 whitespace-nowrap">
                  <%= receipt.original_document_no ? receipt.original_document_no : 'Không có' %>
                </td>
                <td class="py-4 px-4 font-medium text-slate-800">
                  <%= receipt.supplier ? receipt.supplier.name : 'N/A' %>
                </td>
                <td class="py-4 px-4 text-slate-600">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800 border border-slate-200 whitespace-nowrap">
                    <i class="fa-solid fa-warehouse mr-1 text-slate-500"></i> <%= receipt.warehouse ? receipt.warehouse.name : 'N/A' %>
                  </span>
                </td>
                <td class="py-4 px-4 text-right font-extrabold text-emerald-700 whitespace-nowrap">
                  <%= new Intl.NumberFormat('vi-VN').format(receipt.total_amount) %> đ
                </td>
                <td class="py-4 px-4 text-center whitespace-nowrap">
                  <div class="relative inline-block text-left status-dropdown-group">
                    <!-- Trigger Button -->
                    <button type="button" 
                            onclick="toggleRowStatusDropdown('<%= receipt.id %>', event)" 
                            class="inline-flex items-center justify-between px-3 py-1.5 rounded-full text-xs font-bold transition-all shadow-sm border cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-1 <%= receipt.status === 'PUBLIC' ? 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100 focus:ring-emerald-400' : (receipt.status === 'CANCEL' ? 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100 focus:ring-rose-400' : 'bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100 focus:ring-amber-400') %>">
                      <span>
                        <% if (receipt.status === 'PUBLIC') { %>
                          <i class="fa-solid fa-circle-check mr-1.5 text-emerald-500"></i> Public
                        <% } else if (receipt.status === 'CANCEL') { %>
                          <i class="fa-solid fa-ban mr-1.5 text-rose-500"></i> Cancel
                        <% } else { %>
                          <i class="fa-solid fa-pen-to-square mr-1.5 text-amber-500"></i> Draft
                        <% } %>
                      </span>
                      <i class="fa-solid fa-chevron-down text-[10px] ml-2 opacity-70"></i>
                    </button>

                    <!-- Custom Floating Menu -->
                    <div id="statusMenu-<%= receipt.id %>" class="hidden absolute right-0 mt-1 w-44 bg-white rounded-xl shadow-xl border border-slate-200 divide-y divide-slate-100 z-50 overflow-hidden text-left transform transition-all">
                      <div class="py-1">
                        <form method="POST" action="/receipts/<%= receipt.id %>/status">
                          <input type="hidden" name="status" value="DRAFT">
                          <button type="submit" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50 flex items-center transition-colors cursor-pointer">
                            <i class="fa-solid fa-pen-to-square mr-2 text-amber-500 w-4 text-center"></i> Draft (Bản nháp)
                          </button>
                        </form>
                        <form method="POST" action="/receipts/<%= receipt.id %>/status">
                          <input type="hidden" name="status" value="PUBLIC">
                          <button type="submit" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-50 flex items-center transition-colors cursor-pointer">
                            <i class="fa-solid fa-circle-check mr-2 text-emerald-500 w-4 text-center"></i> Public (Phát hành)
                          </button>
                        </form>
                        <form method="POST" action="/receipts/<%= receipt.id %>/status" onsubmit="return confirm('Bạn có chắc chắn muốn chuyển phiếu nhập sang trạng thái Hủy Phiếu?');">
                          <input type="hidden" name="status" value="CANCEL">
                          <button type="submit" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-rose-700 hover:bg-rose-50 flex items-center transition-colors cursor-pointer">
                            <i class="fa-solid fa-ban mr-2 text-rose-500 w-4 text-center"></i> Cancel (Đã hủy)
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-6 text-center whitespace-nowrap min-w-[200px] space-x-1.5">
                  <a href="/receipts/<%= receipt.id %>" title="Xem & In Mẫu 01-VT" class="inline-flex items-center px-3 py-1.5 bg-sky-50 hover:bg-sky-100 text-sky-700 font-medium text-xs rounded-lg transition-colors border border-sky-200">
                    <i class="fa-solid fa-print mr-1.5"></i> Mẫu 01-VT
                  </a>
                  <% if (receipt.status !== 'PUBLIC') { %>
                    <a href="/receipts/<%= receipt.id %>/edit" title="Chỉnh Sửa Phiếu" class="inline-flex items-center px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-700 font-medium text-xs rounded-lg transition-colors border border-amber-200">
                      <i class="fa-solid fa-pen-to-square mr-1"></i> Sửa
                    </a>
                    <form method="POST" action="/receipts/<%= receipt.id %>/delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu nhập <%= receipt.receipt_no %> không?');" class="inline">
                      <button type="submit" title="Xóa Phiếu" class="inline-flex items-center p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition-colors border border-rose-200 cursor-pointer">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="py-12 text-center text-slate-400">
                <i class="fa-solid fa-inbox text-3xl mb-2 block text-slate-300"></i>
                Không tìm thấy phiếu nhập kho phù hợp.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer Controls -->
    <% if (typeof pagination !== 'undefined' && pagination.totalItems > 0) { %>
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-xs text-slate-500">
          Hiển thị <span class="font-bold text-slate-700"><%= (pagination.currentPage - 1) * pagination.pageSize + (receipts.length > 0 ? 1 : 0) %></span>
          đến <span class="font-bold text-slate-700"><%= (pagination.currentPage - 1) * pagination.pageSize + receipts.length %></span>
          trên tổng số <span class="font-bold text-slate-700"><%= pagination.totalItems %></span> kết quả
        </div>

        <div class="flex items-center space-x-1">
          <!-- Button Trang trước -->
          <% if (pagination.currentPage > 1) { %>
            <a href="/receipts?page=<%= pagination.currentPage - 1 %>&keyword=<%= encodeURIComponent(query.keyword || '') %>&warehouse_id=<%= encodeURIComponent(query.warehouse_id || '') %>&supplier_id=<%= encodeURIComponent(query.supplier_id || '') %>&status=<%= encodeURIComponent(query.status || '') %>" 
               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-all">
              <i class="fa-solid fa-chevron-left mr-1"></i> Trước
            </a>
          <% } else { %>
            <span class="px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-100 text-slate-400 text-xs font-semibold cursor-not-allowed">
              <i class="fa-solid fa-chevron-left mr-1"></i> Trước
            </span>
          <% } %>

          <!-- Các nút Số trang -->
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <% if (p === pagination.currentPage) { %>
              <span class="px-3 py-1.5 rounded-lg bg-sky-600 text-white text-xs font-bold shadow-sm">
                <%= p %>
              </span>
            <% } else { %>
              <a href="/receipts?page=<%= p %>&keyword=<%= encodeURIComponent(query.keyword || '') %>&warehouse_id=<%= encodeURIComponent(query.warehouse_id || '') %>&supplier_id=<%= encodeURIComponent(query.supplier_id || '') %>&status=<%= encodeURIComponent(query.status || '') %>" 
                 class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-all">
                <%= p %>
              </a>
            <% } %>
          <% } %>

          <!-- Button Trang sau -->
          <% if (pagination.currentPage < pagination.totalPages) { %>
            <a href="/receipts?page=<%= pagination.currentPage + 1 %>&keyword=<%= encodeURIComponent(query.keyword || '') %>&warehouse_id=<%= encodeURIComponent(query.warehouse_id || '') %>&supplier_id=<%= encodeURIComponent(query.supplier_id || '') %>&status=<%= encodeURIComponent(query.status || '') %>" 
               class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold transition-all">
              Sau <i class="fa-solid fa-chevron-right ml-1"></i>
            </a>
          <% } else { %>
            <span class="px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-100 text-slate-400 text-xs font-semibold cursor-not-allowed">
              Sau <i class="fa-solid fa-chevron-right ml-1"></i>
            </span>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

</div>

<script>
  function toggleRowStatusDropdown(receiptId, event) {
    if (event) event.stopPropagation();
    document.querySelectorAll('[id^="statusMenu-"]').forEach(menu => {
      if (menu.id !== `statusMenu-${receiptId}`) {
        menu.classList.add('hidden');
      }
    });
    const menu = document.getElementById(`statusMenu-${receiptId}`);
    if (menu) {
      menu.classList.toggle('hidden');
    }
  }

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.status-dropdown-group')) {
      document.querySelectorAll('[id^="statusMenu-"]').forEach(menu => {
        menu.classList.add('hidden');
      });
    }
  });
</script>
