<div class="space-y-6">
  
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Danh Mục Nhân Viên & Phân Vai Trò Ký Duyệt</h1>
      <p class="text-sm text-slate-500 mt-1">
        Quy định: Mỗi kho có 01 Thủ kho & các Nhân viên độc lập, 01 Kế toán trưởng toàn công ty (Mẫu 01-VT)
      </p>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      
      <!-- Search Keyword -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Tìm Kiếm Nhân Viên</label>
        <div class="relative">
          <input type="text" id="employeeSearchKeyword" placeholder="Mã NV, họ tên, phòng ban..." class="w-full text-sm pl-9 pr-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
        </div>
      </div>

      <!-- Filter by Warehouse -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Lọc Theo Kho Hàng</label>
        <select id="employeeWarehouseFilter" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả kho --</option>
          <% if (typeof warehouses !== 'undefined') { %>
            <% warehouses.forEach(w => { %>
              <option value="<%= w.id %>"><%= w.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Filter by Role -->
      <div>
        <label class="block text-xs font-semibold text-slate-600 mb-1">Lọc Theo Vai Trò Ký Duyệt</label>
        <select id="employeeRoleFilter" class="w-full text-sm px-3 py-2 border border-slate-300 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-sky-500 outline-none">
          <option value="">-- Tất cả vai trò --</option>
          <option value="CREATOR">Người Lập Phiếu</option>
          <option value="KEEPER">Thủ Kho</option>
          <option value="ACCOUNTANT">Kế Toán Trưởng</option>
        </select>
      </div>

    </div>
  </div>

  <!-- Employees Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm" id="employeesTable">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-b border-slate-200">
            <th class="py-3.5 px-6">Mã NV</th>
            <th class="py-3.5 px-6">Họ Và Tên</th>
            <th class="py-3.5 px-6">Phòng Ban / Chức Danh</th>
            <th class="py-3.5 px-6">Kho Phụ Trách</th>
            <th class="py-3.5 px-6">Vai Trò Ký Duyệt (Mẫu 01-VT)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% employees.forEach(e => { 
            const assignedWh = typeof warehouses !== 'undefined' ? warehouses.find(w => w.id === e.warehouse_id) : null;
          %>
            <tr class="employee-row hover:bg-slate-50/80 transition-colors" 
                data-warehouse-id="<%= e.warehouse_id || '' %>"
                data-role="<%= e.role || '' %>"
                data-search="<%= (e.code + ' ' + e.full_name + ' ' + (e.department || '')).toLowerCase() %>">
              <td class="py-4 px-6 font-mono font-bold text-sky-700"><%= e.code %></td>
              <td class="py-4 px-6 font-bold text-slate-900"><%= e.full_name %></td>
              <td class="py-4 px-6 text-slate-600"><%= e.department || 'N/A' %></td>
              <td class="py-4 px-6">
                <% if (assignedWh) { %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                    <i class="fa-solid fa-warehouse text-sky-600 mr-1.5"></i> <%= assignedWh.name %>
                  </span>
                <% } else if (e.role === 'ACCOUNTANT') { %>
                  <span class="text-xs text-slate-400 italic">Toàn Công Ty</span>
                <% } else { %>
                  <span class="text-xs text-slate-400 italic">Chưa phân kho</span>
                <% } %>
              </td>
              <td class="py-4 px-6">
                <% if (e.role === 'CREATOR') { %>
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-sky-100 text-sky-800 border border-sky-300 inline-flex items-center">
                    <i class="fa-solid fa-pen-nib mr-1.5"></i> Người Lập
                  </span>
                <% } else if (e.role === 'KEEPER') { %>
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300 inline-flex items-center">
                    <i class="fa-solid fa-key mr-1.5"></i> Thủ Kho
                  </span>
                <% } else if (e.role === 'ACCOUNTANT') { %>
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 inline-flex items-center">
                    <i class="fa-solid fa-calculator mr-1.5"></i> Kế Toán Trưởng
                  </span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const keywordInput = document.getElementById('employeeSearchKeyword');
    const warehouseFilter = document.getElementById('employeeWarehouseFilter');
    const roleFilter = document.getElementById('employeeRoleFilter');
    const rows = document.querySelectorAll('.employee-row');

    function applyFilters() {
      const keyword = (keywordInput?.value || '').toLowerCase().trim();
      const warehouseId = warehouseFilter?.value || '';
      const role = roleFilter?.value || '';

      rows.forEach(row => {
        const rowSearch = row.dataset.search || '';
        const rowWh = row.dataset.warehouseId || '';
        const rowRole = row.dataset.role || '';

        const matchKeyword = !keyword || rowSearch.includes(keyword);
        const matchWh = !warehouseId || rowWh === warehouseId || (rowRole === 'ACCOUNTANT');
        const matchRole = !role || rowRole === role;

        if (matchKeyword && matchWh && matchRole) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    keywordInput?.addEventListener('input', applyFilters);
    warehouseFilter?.addEventListener('change', applyFilters);
    roleFilter?.addEventListener('change', applyFilters);
  });
</script>
