<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200 pb-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">Danh Mục Kho Hàng</h1>
      <p class="text-sm text-slate-500 mt-1">Danh sách nhà kho vật lý và địa điểm lưu kho</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <% warehouses.forEach(w => { %>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-bold text-sky-700 px-2.5 py-1 bg-sky-50 rounded-lg border border-sky-200"><%= w.code %></span>
          <i class="fa-solid fa-warehouse text-slate-400 text-xl"></i>
        </div>
        <h3 class="font-bold text-base text-slate-900"><%= w.name %></h3>
        <p class="text-xs text-slate-500 flex items-start">
          <i class="fa-solid fa-location-dot text-rose-500 mr-2 mt-0.5"></i> <%= w.address || 'Chưa cập nhật địa điểm' %>
        </p>
      </div>
    <% }) %>
  </div>
</div>
